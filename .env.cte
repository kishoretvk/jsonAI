# CTE environment variables for GenerativeJson

# (Standardized for consistency)
OIDC_ISSUER=https://cte-issuer.example.com
OIDC_AUDIENCE=cte-audience
OIDC_JWKS_URL=https://cte-issuer.example.com/.well-known/jwks.json
OIDC_ROLE_CLAIM=role
OIDC_REQUIRED_ROLE=generator

OBS_ENABLE_METRICS=true
OBS_ENABLE_TRACING=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://cte-otel.example.com:4317
OTEL_SERVICE_NAME=generativejson-api-cte
OTEL_EXPORTER_OTLP_HEADERS=

# Add any additional CTE-specific variables below
