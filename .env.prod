# Production environment variables for GenerativeJson

OIDC_ISSUER=https://prod-issuer.example.com
OIDC_AUDIENCE=prod-audience
OIDC_JWKS_URL=https://prod-issuer.example.com/.well-known/jwks.json
OIDC_ROLE_CLAIM=role
OIDC_REQUIRED_ROLE=generator

OBS_ENABLE_METRICS=true
OBS_ENABLE_TRACING=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://prod-otel.example.com:4317
OTEL_SERVICE_NAME=generativejson-api-prod
OTEL_EXPORTER_OTLP_HEADERS=

# Add any additional production-specific variables below
