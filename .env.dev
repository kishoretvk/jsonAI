# Development environment variables for GenerativeJson

OIDC_ISSUER=https://dev-issuer.example.com
OIDC_AUDIENCE=dev-audience
OIDC_JWKS_URL=https://dev-issuer.example.com/.well-known/jwks.json
OIDC_ROLE_CLAIM=role
OIDC_REQUIRED_ROLE=generator

OBS_ENABLE_METRICS=true
OBS_ENABLE_TRACING=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=generativejson-api-dev
OTEL_EXPORTER_OTLP_HEADERS=

# Add any additional dev-specific variables below
