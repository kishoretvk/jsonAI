# QA environment variables for GenerativeJson

OIDC_ISSUER=https://qa-issuer.example.com
OIDC_AUDIENCE=qa-audience
OIDC_JWKS_URL=https://qa-issuer.example.com/.well-known/jwks.json
OIDC_ROLE_CLAIM=role
OIDC_REQUIRED_ROLE=generator

OBS_ENABLE_METRICS=true
OBS_ENABLE_TRACING=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://qa-otel.example.com:4317
OTEL_SERVICE_NAME=generativejson-api-qa
OTEL_EXPORTER_OTLP_HEADERS=

# Add any additional QA-specific variables below
