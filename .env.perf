# Performance environment variables for GenerativeJson

OIDC_ISSUER=https://perf-issuer.example.com
OIDC_AUDIENCE=perf-audience
OIDC_JWKS_URL=https://perf-issuer.example.com/.well-known/jwks.json
OIDC_ROLE_CLAIM=role
OIDC_REQUIRED_ROLE=generator

OBS_ENABLE_METRICS=true
OBS_ENABLE_TRACING=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://perf-otel.example.com:4317
OTEL_SERVICE_NAME=generativejson-api-perf
OTEL_EXPORTER_OTLP_HEADERS=

# Add any additional performance-specific variables below
